---
import type { GetStaticPaths } from "astro";
import copy from "../../../docs/events-pages-copy.json";
import { generalCategoryPage } from "../../data/staticPages";
import EventsLayout from "../../layouts/EventsLayout.astro";
import { isGeneralEventCategory, type EventData } from "../../lib/eventSchema";
import { generalCategoriesWithUpcoming, inCategory } from "../../lib/events";
import { getUpcomingEvents } from "../../lib/loadEvents";

export const getStaticPaths = (async () => {
  const now = new Date();
  const upcoming = await getUpcomingEvents(now);
  return generalCategoriesWithUpcoming(upcoming, now).map((category) => ({
    params: { category },
    props: { events: inCategory(upcoming, category) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  events: EventData[];
}

const { events } = Astro.props;
const { category } = Astro.params;
if (!category || !isGeneralEventCategory(category)) throw new Error(`Not a general event category: ${category}`);
const page = copy.categories[category];
const meta = generalCategoryPage(category);
---

<EventsLayout
  meta={meta}
  h1={page.h1}
  intro={page.intro}
  events={events}
  emptyMessage={page.emptyState}
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Events", path: "/events/" },
    { name: page.h1, path: meta.path },
  ]}
/>
