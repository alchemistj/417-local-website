---
import type { GetStaticPaths } from "astro";
import DateStrip from "../../../components/DateStrip.astro";
import EventFilters from "../../../components/EventFilters.astro";
import EventList from "../../../components/EventList.astro";
import WeeklyList from "../../../components/WeeklyList.astro";
import { cityHubCopy, cityHubPage } from "../../../data/staticPages";
import EventsLayout from "../../../layouts/EventsLayout.astro";
import { comingUpEvents, dateStrip, dontMissEvents, uniqueUpcomingEvents } from "../../../lib/calendarView";
import { inlineHeroAvif } from "../../../lib/heroPhoto";
import { citiesWithEvents, eventChips } from "../../../lib/eventRoutes";
import { cityWeekendPath, eventCitySlug } from "../../../lib/eventPaths";
import { isUpcoming } from "../../../lib/events";
import { getRecurring, getSiteEvents } from "../../../lib/loadEvents";
import { groupSeriesByWeekday, recurringCitySlug } from "../../../lib/recurring";

export const getStaticPaths = (async () => {
  const events = await getSiteEvents();
  return citiesWithEvents(events).map((city) => ({ params: { city } }));
}) satisfies GetStaticPaths;

const city = Astro.params.city;
if (!city) throw new Error("Missing city");
const now = new Date();
const events = (await getSiteEvents()).filter((event) => eventCitySlug(event) === city);
const recurring = (await getRecurring()).filter((item) => recurringCitySlug(item) === city);
const dontMiss = dontMissEvents(events, now);
const comingUp = comingUpEvents(events, recurring, city, now);
const upcoming = uniqueUpcomingEvents(events, recurring, city, now, 14);
const weekly = groupSeriesByWeekday(recurring);
const anyUpcoming = events.some((event) => isUpcoming(event, now));
const page = cityHubCopy(city);
const meta = cityHubPage(city);
const weekendHref = cityWeekendPath(city);
// Same photo and crop as the homepage hero, inlined once at build time.
const photo = await inlineHeroAvif({
  file: "src/assets/home/fountain-square.jpg",
  crop: { left: 0, top: 150, width: 1440, height: 330 },
  width: 1280,
  quality: 60,
});
const showFilters = dontMiss.length + comingUp.length + upcoming.length > 0;
---

<EventsLayout
  meta={meta}
  h1={page.h1}
  hero={{
    photo,
    actions: [
      { label: "This weekend", href: weekendHref },
      { label: "Calendar", href: `/events/${city}/calendar/` },
    ],
  }}
  intro={page.intro}
  chips={eventChips(city, events, now, meta.path)}
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Events", path: "/events/" },
    { name: meta.label, path: meta.path },
  ]}
>
  <DateStrip strip={dateStrip(city, events, recurring, now)} />
  {showFilters && <EventFilters />}
  {comingUp.length > 0 && (
    <section aria-labelledby="coming-up-heading">
      <h2 id="coming-up-heading">{page.upcomingHeading}</h2>
      <EventList events={comingUp} idPrefix="coming" />
    </section>
  )}
  {dontMiss.length > 0 && (
    <section aria-labelledby="dont-miss-heading">
      <h2 id="dont-miss-heading">Don't miss this month</h2>
      <EventList events={dontMiss} idPrefix="miss" />
    </section>
  )}
  <section id="upcoming" aria-labelledby={upcoming.length > 0 ? "upcoming-heading" : undefined}>
    {upcoming.length > 0 && (
      <>
        <h2 id="upcoming-heading">Upcoming</h2>
        <EventList events={upcoming} idPrefix="upcoming" />
      </>
    )}
    <p><a class="more-link" href={`/events/${city}/calendar/`}>See the full calendar</a></p>
  </section>
  {weekly.length > 0 && (
    <section aria-labelledby="weekly-happenings">
      <h2 id="weekly-happenings">Weekly happenings</h2>
      <WeeklyList groups={weekly} />
      <p><a class="more-link" href={`/events/${city}/weekly/`}>See all weekly happenings</a></p>
    </section>
  )}
  {!anyUpcoming && weekly.length === 0 && <p class="empty-state">{page.emptyState}</p>}
  <p>{page.businessLink}</p>
</EventsLayout>
