---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import DayPage from "../../../components/DayPage.astro";
import EventCard from "../../../components/EventCard.astro";
import AddToCalendar from "../../../components/AddToCalendar.astro";
import EventFilters from "../../../components/EventFilters.astro";
import EventList from "../../../components/EventList.astro";
import { cityHubPage, generalCategoryCopy, generalCategoryPage } from "../../../data/staticPages";
import EventsLayout from "../../../layouts/EventsLayout.astro";
import { eventAction } from "../../../lib/eventAction";
import { googleCalendarUrl } from "../../../lib/eventCalendar";
import { isGeneralEventCategory, type EventData, type GeneralEventCategory } from "../../../lib/eventSchema";
import { citiesWithEvents, eventChips, listedCategories } from "../../../lib/eventRoutes";
import {
  assertNoReservedEventSlug,
  assertUniqueEventPaths,
  cityDisplayName,
  eventCitySlug,
  eventCardImagePath,
  eventPath,
  eventPublicSlug,
  eventRouteParams,
  mapsSearchUrl,
  venueGuidePath,
} from "../../../lib/eventPaths";
import {
  dayPageDates,
  dayPageDescription,
  dayPageH1,
  dayPageTitle,
  alsoPlaying,
  collapseRuns,
  eventRun,
  eventsOnDate,
  performanceLabel,
  runCanonicalPath,
  runRangeLabel,
  uniqueUpcomingEvents,
} from "../../../lib/calendarView";
import {
  categoryLabel,
  eventJsonLd,
  eventMetaDescription,
  eventPageTitle,
  eventPlaceLine,
  eventPriceText,
  isBusinessCategory,
  moreInCategory,
  relatedUpcoming,
  sourceCredit,
} from "../../../lib/eventPage";
import { isIndexableEvent, isUpcoming, placeName, primaryCategory } from "../../../lib/events";
import { getRecurring, getSiteEvents } from "../../../lib/loadEvents";
import { recurringOnDate } from "../../../lib/recurring";
import { absoluteUrl } from "../../../lib/site";

interface EventProps {
  kind: "event";
  event: EventData;
}

interface CategoryProps {
  kind: "category";
  category: GeneralEventCategory;
}

interface DayProps {
  kind: "day";
  date: string;
}

export const getStaticPaths = (async () => {
  const now = new Date();
  const events = await getSiteEvents();
  const recurring = await getRecurring();
  assertNoReservedEventSlug(events);
  assertUniqueEventPaths(events);
  const eventPaths = events.map((event) => ({
    params: eventRouteParams(event),
    props: { kind: "event" as const, event },
  }));
  const categoryPaths = citiesWithEvents(events).flatMap((citySlug) =>
    listedCategories(
      events.filter((event) => eventCitySlug(event) === citySlug),
      now,
    ).map((category) => ({
      params: { city: citySlug, event: category },
      props: { kind: "category" as const, category },
    })),
  );
  const dayPaths = citiesWithEvents(events).flatMap((citySlug) =>
    dayPageDates(citySlug, events, recurring, now).map((date) => ({
      params: { city: citySlug, event: date },
      props: { kind: "day" as const, date },
    })),
  );
  return [...categoryPaths, ...dayPaths, ...eventPaths];
}) satisfies GetStaticPaths;

const props = Astro.props as EventProps | CategoryProps | DayProps;
const city = Astro.params.city;
if (!city) throw new Error("Missing city");
const now = new Date();
const allEvents = await getSiteEvents();
const recurring = await getRecurring();
const cityName = cityDisplayName(city);
const hub = cityHubPage(city);

const dayDate = props.kind === "day" ? props.date : null;
const dayEvents = dayDate ? eventsOnDate(allEvents, city, dayDate, now) : [];
const dayWeekly = dayDate ? recurringOnDate(recurring, city, dayDate) : [];
const dayDates = dayDate ? dayPageDates(city, allEvents, recurring, now) : [];
const dayIndex = dayDate ? dayDates.indexOf(dayDate) : -1;
const prevDay = dayIndex > 0 ? dayDates[dayIndex - 1] ?? null : null;
const nextDay = dayIndex >= 0 && dayIndex < dayDates.length - 1 ? dayDates[dayIndex + 1] ?? null : null;
const dayMeta = dayDate
  ? {
      path: `/events/${city}/${dayDate}/`,
      title: dayPageTitle(cityName, dayDate),
      description: dayPageDescription(cityName, dayDate, dayEvents, dayWeekly.map((item) => item.title)),
      label: dayPageH1(cityName, dayDate),
    }
  : null;

const category = props.kind === "category" ? props.category : null;
const categoryEvents = category
  ? allEvents.filter((event) => eventCitySlug(event) === city && event.categories.includes(category) && isUpcoming(event, now))
  : [];
const categoryCopy = category && isGeneralEventCategory(category) ? generalCategoryCopy(category, city) : null;
const categoryMeta = category && isGeneralEventCategory(category) ? generalCategoryPage(category, city) : null;

const event = props.kind === "event" ? props.event : null;
const passed = event ? !isUpcoming(event, now) : false;
const price = event ? eventPriceText(event) : "";
const runRange = event ? runRangeLabel(eventRun(event, allEvents, now)) : null;
const action = event && !passed ? eventAction(event) : null;
const maps = event ? mapsSearchUrl(event) : "";
const pagePath = event ? eventPath(event) : "";
const canonicalPath = event ? runCanonicalPath(event, allEvents, now) : "";
const playing = event && !passed ? alsoPlaying(event, allEvents, now) : [];
const pageUrl = pagePath ? absoluteUrl(pagePath) : "";
const icsPath = pagePath ? `${pagePath}event.ics` : "";
const googleUrl = event ? googleCalendarUrl(event, { pageUrl }) : "";
const venue = event ? placeName(event.venue) : "";
const address = event ? placeName(event.address) : "";
const posts = event
  ? (await getCollection("posts")).map((post) => ({ slug: post.id, title: post.data.title as string }))
  : [];
const venuePost = venue ? venueGuidePath(venue, posts) : null;
const venueHref = venuePost || maps;
const venueExternal = !venuePost;
const state = event && typeof event.state === "string" && event.state.trim() ? event.state.trim() : "MO";
const placeLine = event && (venue || address) ? eventPlaceLine(venue, address, cityName, state) : "";
const nearby = event && !passed ? collapseRuns(uniqueUpcomingEvents(allEvents, recurring, city, now), allEvents, now, event).filter((item) => item.id !== event.id).slice(0, 8) : [];
const more = event && !passed ? moreInCategory(event, allEvents, now, nearby) : [];
const related = event && passed ? relatedUpcoming(event, allEvents, now) : [];
const categorySlug = event ? primaryCategory(event) : null;
const categoryCrumb = (() => {
  if (!categorySlug) return null;
  if (isGeneralEventCategory(categorySlug)) {
    const upcoming = allEvents.some(
      (item) => eventCitySlug(item) === city && item.categories.includes(categorySlug) && isUpcoming(item, now),
    );
    if (!upcoming) return null;
    return { name: categoryLabel(categorySlug), path: `/events/${city}/${categorySlug}/` };
  }
  if (isBusinessCategory(categorySlug)) {
    return { name: categoryLabel(categorySlug), path: `/events/springfield-business-events/${categorySlug}/` };
  }
  return null;
})();
const crumbs = event
  ? [
      { name: "Home", path: "/" },
      { name: "Events", path: "/events/" },
      { name: cityName, path: hub.path },
      ...(categoryCrumb ? [categoryCrumb] : []),
      { name: event.title, path: pagePath },
    ]
  : [];
const outbound = (href: string) => href.startsWith("http");
---

{dayDate && dayMeta ? (
  <DayPage
    meta={dayMeta}
    h1={dayPageH1(cityName, dayDate)}
    city={city}
    cityName={cityName}
    hubPath={hub.path}
    events={dayEvents}
    weekly={dayWeekly}
    prev={prevDay}
    next={nextDay}
    chips={eventChips(city, allEvents, now, "")}
  />
) : category && categoryCopy && categoryMeta ? (
  <EventsLayout
    meta={categoryMeta}
    h1={categoryCopy.h1}
    intro={categoryCopy.intro}
    chips={eventChips(city, allEvents, now, categoryMeta.path)}
    backLink={{ href: hub.path, label: `← All ${cityName} events` }}
    crumbs={[
      { name: "Home", path: "/" },
      { name: "Events", path: "/events/" },
      { name: hub.label, path: hub.path },
      { name: categoryCopy.h1, path: categoryMeta.path },
    ]}
  >
    {categoryEvents.length > 0 && <EventFilters />}
    <EventList events={categoryEvents} emptyMessage={categoryCopy.emptyState} idPrefix={category} />
  </EventsLayout>
) : event ? (
  <EventsLayout
    meta={{
      path: canonicalPath,
      title: eventPageTitle(event),
      description: eventMetaDescription(event),
      label: event.title,
    }}
    h1={event.title}
    intro=""
    titleBand={false}
    crumbs={crumbs}
    chips={eventChips(city, allEvents, now, "")}
    noindex={!isIndexableEvent(event, now)}
    ogImagePath={eventCardImagePath(event)}
    jsonLd={[eventJsonLd(event)]}
  >
    <header class="event-card-band">
      <EventCard event={event} runRange={runRange} price={price} venueHref={venue ? venueHref : ""} venueExternal={venueExternal} />
      {playing.length > 0 && <p class="event-card-note">Also playing: {playing.map(performanceLabel).join(" · ")}</p>}
      {passed && <p class="passed-note">This event has passed.</p>}
    </header>
    {passed && related.length > 0 && (
      <section class="related-block" aria-labelledby="related-heading">
        <h2 id="related-heading">Coming up in {cityName}</h2>
        <EventList events={related} idPrefix="related" />
      </section>
    )}
    {event.description && <p>{event.description}</p>}
    {placeLine && (
      <p>
        {placeLine}
        {passed && (
          <>
            {" "}
            <a href={maps} rel="noopener">Get directions</a>
          </>
        )}
      </p>
    )}
    {!passed && (
      <div class="event-actions">
        {action?.href && (
          <a class="btn" href={action.href} rel={outbound(action.href) ? "noopener" : undefined}>{action.label}</a>
        )}
        {action?.priceText && <span class="event-extra">{action.priceText}</span>}
        {action?.secondary?.href && (
          <a class="text-link" href={action.secondary.href} rel={outbound(action.secondary.href) ? "noopener" : undefined}>{action.secondary.label}</a>
        )}
        <AddToCalendar googleUrl={googleUrl} icsPath={icsPath} downloadName={`${eventPublicSlug(event)}.ics`} />
      </div>
    )}
    {nearby.length > 0 && (
      <section class="related-block" aria-labelledby="nearby-heading">
        <h2 id="nearby-heading">More events in {cityName}</h2>
        <EventList events={nearby} idPrefix="nearby" />
      </section>
    )}
    {more.length > 0 && categorySlug && (
      <section class="related-block" aria-labelledby="more-heading">
        <h2 id="more-heading">More {categoryLabel(categorySlug)} in {cityName}</h2>
        <EventList events={more} idPrefix="more" />
      </section>
    )}
    <p class="source-note">{sourceCredit(event)}</p>
  </EventsLayout>
) : (
  <p>Missing event.</p>
)}

<style>
  /* Phones get the same stacked date tile as desktop, above the title (the default row is "NOV 19 Thu · 10:00 AM"). */
  @media (max-width: 640px) {
    .event-card-band :global(.event-card-date) {
      flex-direction: column;
      align-items: flex-start;
      align-self: flex-start;
      justify-content: center;
      gap: 0.15rem;
      width: 8.75rem;
      flex: none;
      padding: 0.8rem 0.85rem;
      border-radius: 12px;
      background: color-mix(in srgb, #000 18%, transparent);
    }
    .event-card-band :global(.event-card-day) {
      font-size: 3.15rem;
    }
  }
</style>
