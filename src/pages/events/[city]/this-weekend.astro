---
import type { GetStaticPaths } from "astro";
import WeekendPage from "../../../components/WeekendPage.astro";
import { citiesWithEvents } from "../../../lib/eventRoutes";
import { getSiteEvents } from "../../../lib/loadEvents";

// Springfield's weekend guide lives at its own flat address; other cities keep this one.
export const getStaticPaths = (async () => {
  const events = await getSiteEvents();
  return citiesWithEvents(events)
    .filter((city) => city !== "springfield")
    .map((city) => ({ params: { city } }));
}) satisfies GetStaticPaths;

const city = Astro.params.city;
if (!city) throw new Error("Missing city");
---

<WeekendPage city={city} />
