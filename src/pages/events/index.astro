---
import copy from "../../../docs/events-pages-copy.json";
import { BUSINESS_EVENTS, EVENTS_HUB, cityHubPage } from "../../data/staticPages";
import EventsLayout from "../../layouts/EventsLayout.astro";
import { citiesWithEvents } from "../../lib/eventRoutes";
import { cityDisplayName } from "../../lib/eventPaths";
import { getSiteEvents } from "../../lib/loadEvents";

const cities = citiesWithEvents(await getSiteEvents());
const business = BUSINESS_EVENTS[0];

/** Names every city that has events, in the same order as the city links. */
function cityListSentence(names: string[]): string | null {
  if (names.length === 0) return null;
  if (names.length === 1) return `${names[0]} is the city we list today.`;
  const last = names[names.length - 1];
  return `${names.slice(0, -1).join(", ")} and ${last} are the cities we list today.`;
}

const listedToday = cityListSentence(cities.map((city) => cityDisplayName(city)));
const intro = listedToday ? [copy.region.intro[0], listedToday, ...copy.region.intro.slice(1)] : copy.region.intro;
---

<EventsLayout
  meta={EVENTS_HUB}
  h1={copy.region.h1}
  intro={intro}
  crumbs={[{ name: "Home", path: "/" }, { name: "Events", path: "/events/" }]}
>
  {cities.length === 0 ? (
    <p>{copy.region.emptyState}</p>
  ) : (
    <nav aria-label="Cities">
      <ul class="subnav">
        {cities.map((city) => (
          <li><a href={cityHubPage(city).path}>{cityDisplayName(city)}</a></li>
        ))}
        <li><a href={business.path}>{business.label}</a></li>
      </ul>
    </nav>
  )}
</EventsLayout>
