---
import copy from "../../../docs/events-pages-copy.json";
import { BUSINESS_EVENTS, EVENTS_HUB, cityHubPage } from "../../data/staticPages";
import EventsLayout from "../../layouts/EventsLayout.astro";
import { citiesWithEvents } from "../../lib/eventRoutes";
import { cityDisplayName } from "../../lib/eventPaths";
import { getSiteEvents } from "../../lib/loadEvents";

const cities = citiesWithEvents(await getSiteEvents());
const business = BUSINESS_EVENTS[0];
---

<EventsLayout
  meta={EVENTS_HUB}
  h1={copy.region.h1}
  intro={copy.region.intro}
  crumbs={[{ name: "Home", path: "/" }, { name: "Events", path: "/events/" }]}
>
  {cities.length === 0 ? (
    <p>{copy.region.emptyState}</p>
  ) : (
    <nav aria-label="Cities">
      <ul class="subnav">
        {cities.map((city) => (
          <li><a href={cityHubPage(city).path}>{cityDisplayName(city)}</a></li>
        ))}
        <li><a href={business.path}>{business.label}</a></li>
      </ul>
    </nav>
  )}
</EventsLayout>
