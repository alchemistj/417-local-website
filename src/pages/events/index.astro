---
import copy from "../../../docs/events-pages-copy.json";
import { BUSINESS_EVENTS, EVENTS_HUB } from "../../data/staticPages";
import { withCityLabel } from "../../data/weekendCities";
import EventsLayout from "../../layouts/EventsLayout.astro";
import { fourWeekCount, regionDontMiss, topWeekendEvents } from "../../lib/calendarView";
import { citiesWithEvents } from "../../lib/eventRoutes";
import { WEEKEND_CITY_SLUGS, cityDisplayName, cityWeekendPath, eventPath } from "../../lib/eventPaths";
import { getRecurring, getSiteEvents } from "../../lib/loadEvents";
import EventList from "../../components/EventList.astro";
import LeadForm from "../../components/LeadForm.astro";
import { FORM_KEYS } from "../../lib/formsLead";
import { inlineHeroAvif } from "../../lib/heroPhoto";

const now = new Date();
const events = await getSiteEvents();
const recurring = await getRecurring();
const business = BUSINESS_EVENTS[0];
const dontMiss = regionDontMiss(events, recurring, now).map((event) => withCityLabel(event));
const moreTowns = citiesWithEvents(events).filter((city) => !(WEEKEND_CITY_SLUGS as readonly string[]).includes(city));
const [intro, confirm] = copy.region.intro;
const photo = await inlineHeroAvif({
  file: "src/assets/home/fountain-square.jpg",
  crop: { left: 0, top: 180, width: 1440, height: 520 },
  width: 1280,
  quality: 50,
});
const cards = WEEKEND_CITY_SLUGS.map((city) => {
  const count = fourWeekCount(events, city, now);
  const featured = topWeekendEvents(events, city, now, 1)[0] ?? null;
  return {
    city,
    name: cityDisplayName(city),
    count,
    featured,
    hub: `/events/${city}/`,
    weekend: cityWeekendPath(city),
  };
});
const signupFields = [
  { name: "name", label: "Name", value: "Events subscriber", hidden: true },
  { name: "email", label: "Email", type: "email" as const, required: true, autocomplete: "email" },
  {
    name: "message",
    label: "Message",
    type: "textarea" as const,
    value: "Please email new Southwest Missouri experiences.",
    hidden: true,
  },
];
---

<EventsLayout
  meta={EVENTS_HUB}
  h1={copy.region.h1}
  intro={intro}
  photoHero={photo}
  crumbs={[{ name: "Home", path: "/" }, { name: "Events", path: "/events/" }]}
>
  <div class="events-signup" slot="band">
    <p class="events-signup-title">Get all new experiences delivered right to your inbox</p>
    <LeadForm id="events-inbox" formKey={FORM_KEYS.contact} fields={signupFields} submitLabel="Sign up" />
  </div>
  <nav class="sw-cities" aria-label="Southwest Missouri cities">
    {cards.map((card) => (
      <article class:list={["sw-card", card.city === "springfield" && "sw-lead"]}>
        <h2>{card.name}</h2>
        <p class="sw-feature">
          {card.featured ? <a href={eventPath(card.featured)}>{card.featured.title}</a> : "Nothing listed yet."}
        </p>
        <p class="sw-count">{card.count} {card.count === 1 ? "event" : "events"} in the next 4 weeks</p>
        <div class="sw-go">
          <a class="btn" href={card.weekend}>This weekend</a>
          <a class="btn sw-secondary" href={card.hub}>{card.name} events</a>
        </div>
      </article>
    ))}
  </nav>
  <p class="source-note">{confirm}</p>
  {dontMiss.length > 0 && (
    <section aria-labelledby="dont-miss-heading">
      <h2 id="dont-miss-heading" class="sw-h">Don't miss across Southwest Missouri: the next 4 weeks</h2>
      <EventList events={dontMiss} idPrefix="miss" allEvents={events} />
    </section>
  )}
  <section aria-labelledby="more-towns-heading">
    <h2 id="more-towns-heading">More towns</h2>
    <ul class="subnav">
      {moreTowns.map((city) => (
        <li><a href={`/events/${city}/`}>{cityDisplayName(city)}</a></li>
      ))}
      <li><a href={business.path}>{business.label}</a></li>
    </ul>
  </section>
</EventsLayout>

<style is:global>
  .events-hub-hero {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    min-height: 32rem;
    display: flex;
    align-items: center;
    padding-block: 1.5rem 1.75rem;
    color: var(--white);
    text-align: center;
    background: #16384c;
  }
  .events-hub-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center 42%;
  }
  .events-hub-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 32, 0.55);
  }
  .events-hub-hero .container { position: relative; z-index: 1; }
  .events-hub-hero h1,
  .events-hub-hero .lead { color: var(--white); }
  .events-hub-hero h1 { text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45); }
  .events-hub-hero .lead { margin-top: 0.75rem; max-width: 40rem; margin-inline: auto; }
  .events-hub-hero .crumbs a,
  .events-hub-hero .crumbs [aria-current="page"] { color: var(--white); }
  .events-hub-hero .crumbs [aria-current="page"] { text-decoration: none; }
  .events-hub-hero .crumbs li + li::before { color: var(--white); }
  .events-hub-hero .crumbs ol { max-width: 100%; }
  .events-signup {
    margin: 1rem auto 0;
    max-width: 34rem;
    padding: 0.85rem 1rem 0.95rem;
    border-radius: 12px;
    background: var(--white);
    color: var(--ink);
    text-align: left;
  }
  .events-signup-title { margin: 0 0 0.65rem; font-weight: 700; line-height: 1.35; }
  .events-signup .lead-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: flex-end;
  }
  .events-signup .lead-form > div:has(input[type="email"]) { flex: 1 1 12rem; }
  .events-signup .lead-form label { color: var(--ink); }
  .events-signup .lead-form .btn { width: auto; }
  .events-signup .lead-form > p,
  .events-signup .lead-form > noscript { flex: 1 1 100%; margin: 0; }
  .sw-cities {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 0;
    text-align: left;
  }
  .sw-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: 0.9rem 0.95rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--white);
    color: var(--ink);
  }
  .sw-cities h2 { margin: 0; color: var(--ink); font-size: 1.2rem; font-weight: 700; line-height: 1.15; }
  .sw-lead h2 { font-size: 1.4rem; }
  .sw-feature {
    margin: 0.4rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
    min-height: 2.7em;
  }
  .sw-feature a { color: var(--ink); font-weight: 400; text-decoration: none; }
  .sw-feature a:hover { color: var(--blue); text-decoration: underline; }
  .sw-count { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.85rem; }
  .sw-go { display: flex; flex-direction: column; gap: 0.4rem; margin-top: auto; padding-top: 0.75rem; }
  .sw-go .btn { width: 100%; }
  .sw-secondary { background: var(--white); color: var(--blue); border-color: var(--blue); }
  .sw-secondary:hover { background: var(--tint); color: var(--blue-deep); border-color: var(--blue-deep); }
  .sw-h { text-wrap: balance; }
  @media (max-width: 559px) {
    .events-signup .lead-form > div:has(.btn) { flex: 1 1 100%; }
    .events-signup .lead-form .btn { width: 100%; }
  }
  @media (min-width: 720px) {
    .sw-cities { grid-template-columns: 1.15fr 1fr 1fr; grid-template-rows: auto auto; gap: 0.75rem; }
    .sw-lead { grid-column: 1; grid-row: span 2; }
    .sw-lead h2 { font-size: 1.7rem; }
  }
</style>
