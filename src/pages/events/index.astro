---
import copy from "../../../docs/events-pages-copy.json";
import { BUSINESS_EVENTS, EVENTS_HUB } from "../../data/staticPages";
import { withCityLabel } from "../../data/weekendCities";
import EventsLayout from "../../layouts/EventsLayout.astro";
import { fourWeekCount, regionDontMiss, topWeekendEvent } from "../../lib/calendarView";
import { citiesWithEvents } from "../../lib/eventRoutes";
import { WEEKEND_CITY_SLUGS, cityDisplayName, cityWeekendPath } from "../../lib/eventPaths";
import { getRecurring, getSiteEvents } from "../../lib/loadEvents";
import EventList from "../../components/EventList.astro";

const now = new Date();
const events = await getSiteEvents();
const recurring = await getRecurring();
const business = BUSINESS_EVENTS[0];
const dontMiss = regionDontMiss(events, recurring, now).map((event) => withCityLabel(event));
const moreTowns = citiesWithEvents(events).filter((city) => !(WEEKEND_CITY_SLUGS as readonly string[]).includes(city));
const cards = WEEKEND_CITY_SLUGS.map((city) => {
  const count = fourWeekCount(events, city, now);
  const top = topWeekendEvent(events, city, now);
  return {
    city,
    name: cityDisplayName(city),
    countLabel: `${count} event${count === 1 ? "" : "s"} in the next 4 weeks`,
    top: top?.title ?? "",
    hub: `/events/${city}/`,
    weekend: cityWeekendPath(city),
  };
});
---

<EventsLayout
  meta={EVENTS_HUB}
  h1={copy.region.h1}
  intro={copy.region.intro}
  crumbs={[{ name: "Home", path: "/" }, { name: "Events", path: "/events/" }]}
>
  <nav class="sw-hero" slot="band" aria-label="Southwest Missouri cities">
    {cards.map((card) => (
      <article class="sw-card" style="padding:.9rem 1rem;border:2px solid var(--white);border-radius:12px;text-align:left;margin-top:.75rem">
        <h2 style={card.city === "springfield" ? "font-size:2rem" : undefined}><a class="more-link" href={card.hub}>{card.name}</a></h2>
        <p>{card.countLabel}</p>
        <p>{card.top ? card.top : "Nothing listed this weekend yet."}</p>
        <ul class="subnav">
          <li><a href={card.hub}>{card.name} events</a></li>
          <li><a href={card.weekend}>This weekend</a></li>
        </ul>
      </article>
    ))}
  </nav>
  {dontMiss.length > 0 && (
    <section aria-labelledby="dont-miss-heading">
      <h2 id="dont-miss-heading">Don't miss across Southwest Missouri: the next 4 weeks</h2>
      <EventList events={dontMiss} idPrefix="miss" allEvents={events} />
    </section>
  )}
  <section aria-labelledby="more-towns-heading">
    <h2 id="more-towns-heading">More towns</h2>
    <ul class="subnav">
      {moreTowns.map((city) => (
        <li><a href={`/events/${city}/`}>{cityDisplayName(city)}</a></li>
      ))}
      <li><a href={business.path}>{business.label}</a></li>
    </ul>
  </section>
</EventsLayout>

<style>
  @media (min-width: 720px) {
    .sw-hero { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 0.75rem; }
    .sw-hero > :first-child { grid-row: span 2; }
  }
</style>
