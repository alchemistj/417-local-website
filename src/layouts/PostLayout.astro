---
import { Image, getImage } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { SITE_NAME, absoluteUrl } from "../lib/site";
import HexPattern from "../components/HexPattern.astro";
import skyline from "../assets/decor/springfield-skyline.png";
import { LANDING_EYEBROW } from "../data/landingPages";
import { postCrumbs, sortByUpdated } from "../lib/routes";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, seoTitle, description, published, updated, category, heroImage, heroAlt, heroPosition, kind } = post.data;
const isLanding = kind === "page";
const eyebrow = LANDING_EYEBROW[post.id];
const { Content } = await render(post);

// small-business-success: the first paragraph (the lead) moves into the white card under the H1.
// Other landing pages and articles render the Markdown as is.
const leadSplit = isLanding && !eyebrow ? (post.rendered?.html ?? "").match(/^\s*(<p[\s>][\s\S]*?<\/p>)([\s\S]*)$/) : null;
const leadHtml = leadSplit?.[1];
const restHtml = leadSplit?.[2];

const path = `/${post.id}/`;
const heroForLd = heroImage ? await getImage({ src: heroImage, width: 1200 }) : undefined;
const updatedLabel = updated.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });

// Three related articles from the same category (never the article itself).
const same = (await getCollection("posts")).filter((p) => p.data.category === category && p.id !== post.id);
const related = sortByUpdated(same.map((p) => ({ ...p, title: p.data.title, updated: p.data.updated }))).slice(0, 3);

const crumbs = postCrumbs({ slug: post.id, title, category });

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  mainEntityOfPage: absoluteUrl(path),
  datePublished: published.toISOString().slice(0, 10),
  dateModified: updated.toISOString().slice(0, 10),
  author: { "@type": "Organization", name: SITE_NAME, url: absoluteUrl("/") },
  publisher: { "@id": `${absoluteUrl("/")}#organization` },
  ...(heroForLd ? { image: absoluteUrl(heroForLd.src) } : {}),
};
const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: absoluteUrl(c.path),
  })),
};
---

<BaseLayout
  title={seoTitle}
  description={description}
  path={path}
  ogType="article"
  ogImage={heroImage}
  jsonLd={[articleLd, crumbLd]}
>
  <article class={isLanding ? "landing" : undefined}>
    {isLanding ? (
      eyebrow ? (
        <header class="landing-band skyline-band">
          <div class="container">
            <p class="eyebrow">{eyebrow}</p>
            <h1>{title}</h1>
          </div>
          <Image class="skyline" src={skyline} alt="" widths={[800, 1600, 2001]} sizes="100vw" format="webp" loading="eager" decoding="async" />
        </header>
      ) : (
        <header class="landing-band card-band">
          <div class="container">
            <div class="landing-card">
              <h1>{title}</h1>
              {leadHtml && <div class="lead-text" set:html={leadHtml} />}
            </div>
          </div>
        </header>
      )
    ) : (
      <header class="article-top">
        <div class={`article-top-inner container container-wide ${heroImage ? "" : "no-photo"}`}>
          <div class="article-title">
            <h1>{title}</h1>
            <p class="byline">Updated {updatedLabel}</p>
            <p class="byline">By {SITE_NAME} Editorial Team</p>
          </div>
          {heroImage && (
            <figure class="article-photo" style={heroPosition ? `--hero-pos: ${heroPosition}` : undefined}>
              <Image
                src={heroImage}
                alt={heroAlt ?? ""}
                width={1080}
                height={900}
                widths={[480, 720, 1080]}
                sizes="(min-width: 1080px) 540px, (min-width: 860px) 50vw, 100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          )}
        </div>
        <HexPattern />
      </header>
    )}
    <div class="container">
      <div class="prose">
        {restHtml !== undefined ? <Fragment set:html={restHtml} /> : <Content />}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="band band-tint" aria-labelledby="related-heading">
      <div class="container">
        <div class="section-head"><h2 id="related-heading">Read Next</h2></div>
        <ul class="card-grid cols-3">
          {related.map((p) => <ArticleCard post={p} />)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
