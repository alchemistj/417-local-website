---
import BaseLayout from "./BaseLayout.astro";
import EventChips from "../components/EventChips.astro";
import EventList from "../components/EventList.astro";
import CtaBand from "../components/CtaBand.astro";
import type { StaticPageMeta } from "../data/staticPages";
import type { EventChip } from "../lib/eventRoutes";
import type { EventData } from "../lib/eventSchema";
import type { InlineHero } from "../lib/heroPhoto";
import { absoluteUrl } from "../lib/site";

interface Props {
  meta: StaticPageMeta;
  h1: string;
  intro: string | readonly string[];
  events?: EventData[];
  crumbs: { name: string; path: string }[];
  /** Show the business-events sub navigation. */
  subnav?: { label: string; href: string }[];
  /** Replaces the business-events empty sentence. Business pages omit this. */
  emptyMessage?: string;
  chips?: EventChip[];
  backLink?: { href: string; label: string };
  /** Photo hero (same pattern as the homepage) with the H1, a subhead and buttons in place of the blue band. */
  hero?: { photo: InlineHero; actions: { label: string; href: string }[] };
}
const { meta, h1, intro, events = [], crumbs, subnav, emptyMessage, chips, backLink, hero } = Astro.props;
const paragraphs = typeof intro === "string" ? [intro] : intro;
const customBody = Astro.slots.has("default");

const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: absoluteUrl(c.path),
  })),
};
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} jsonLd={[crumbLd]}>
  {hero && (
    <img
      slot="hero-photo"
      class="atf-photo"
      src={hero.photo.src}
      alt=""
      width={hero.photo.width}
      height={hero.photo.height}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      data-ff-lcp-hero
    />
  )}
  {hero && (
    <section class="home-hero event-hero">
      <h1>{h1}</h1>
      <p class="hero-sub">{paragraphs[0]}</p>
      <div class="btn-row">
        {hero.actions.map((a, i) => <a class:list={["btn", i === 0 ? "btn-light" : "btn-outline"]} href={a.href}>{a.label}</a>)}
      </div>
    </section>
  )}
  {hero && <span class="atf-ready" hidden></span>}
  {hero && chips && (
    <section class="band event-chips-band">
      <div class="container">
        <EventChips chips={chips} />
        {paragraphs.slice(1).map((paragraph) => <p class="event-note">{paragraph}</p>)}
      </div>
    </section>
  )}
  {!hero && <section class="band band-blue page-band">
    <div class="container">
      <h1>{h1}</h1>
      {backLink && <p class="back-link"><a href={backLink.href}>{backLink.label}</a></p>}
      {paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
      {chips && <EventChips chips={chips} />}
      <slot name="band" />
      {subnav && (
        <nav aria-label="Event types">
          <ul class="subnav">
            {subnav.map((l) => (
              <li><a href={l.href} aria-current={l.href === meta.path ? "page" : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>}
  <section class="band">
    <div class:list={["container", customBody && "stack"]}>
      {customBody ? <slot /> : <EventList events={events} emptyMessage={emptyMessage} />}
    </div>
  </section>
  <CtaBand
    heading="Hosting an Event?"
    body="Tell us about it and we'll consider it for the events page."
    primary={{ label: "Submit Your Event", href: "/submit-your-event/" }}
  />
</BaseLayout>
