---
import BaseLayout from "./BaseLayout.astro";
import EventChips from "../components/EventChips.astro";
import EventList from "../components/EventList.astro";
import CtaBand from "../components/CtaBand.astro";
import type { StaticPageMeta } from "../data/staticPages";
import type { EventChip } from "../lib/eventRoutes";
import type { EventData } from "../lib/eventSchema";
import type { InlineHero } from "../lib/heroPhoto";
import { absoluteUrl } from "../lib/site";

interface Props {
  meta: StaticPageMeta;
  h1: string;
  intro: string | readonly string[];
  events?: EventData[];
  crumbs: { name: string; path: string }[];
  /** Show the business-events sub navigation. */
  subnav?: { label: string; href: string }[];
  /** Replaces the business-events empty sentence. Business pages omit this. */
  emptyMessage?: string;
  chips?: EventChip[];
  backLink?: { href: string; label: string };
  /**
   * City-hub actions (This weekend, Calendar), drawn in the shared blue header.
   * `photo` stays on the prop so the hub can keep passing it, and is not painted:
   * every events page uses this one header.
   */
  hero?: { photo: InlineHero; actions: { label: string; href: string }[] };
  /**
   * Region hub only. Replaces the blue band with the fountain photo.
   * The photo is the first paintable element, same pattern as the homepage.
   */
  photoHero?: InlineHero;
  /**
   * Shared blue header. The event page passes false so the card stays the header;
   * the breadcrumb still shows, with the chips under it.
   */
  titleBand?: boolean;
  /** Share image for the event page. Other pages omit it. */
  ogImagePath?: string;
  /** Passed event pages set this once the date is 90 days old. */
  noindex?: boolean;
  /** Extra JSON-LD graphs, after the breadcrumb. The event page passes the Event node. */
  jsonLd?: Record<string, unknown>[];
}
const {
  meta,
  h1,
  intro,
  events = [],
  crumbs,
  subnav,
  emptyMessage,
  chips,
  backLink,
  hero,
  photoHero,
  titleBand = true,
  ogImagePath,
  noindex = false,
  jsonLd = [],
} = Astro.props;
const paragraphs = typeof intro === "string" ? [intro] : intro;
const customBody = Astro.slots.has("default");

const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: absoluteUrl(c.path),
  })),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={meta.path}
  ogImagePath={ogImagePath}
  noindex={noindex}
  jsonLd={[crumbLd, ...jsonLd]}
>
  {photoHero && (
    <img
      slot="hero-photo"
      class="atf-photo events-hub-photo"
      src={photoHero.src}
      alt=""
      width={photoHero.width}
      height={photoHero.height}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      data-ff-lcp-hero
    />
  )}
  <section class:list={[photoHero ? "events-hub-hero" : titleBand ? "band band-blue page-band" : "event-crumb-row"]}>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) => (
            <li>
              {index < crumbs.length - 1 ? (
                <a href={crumb.path}>{crumb.name}</a>
              ) : (
                <span aria-current="page">{crumb.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
      {(titleBand || photoHero) && <h1>{h1}</h1>}
      {photoHero && <span class="atf-ready" hidden></span>}
      {(titleBand || photoHero) && backLink && <p class="back-link"><a href={backLink.href}>{backLink.label}</a></p>}
      {(titleBand || photoHero) && paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
      {titleBand && !photoHero && hero && hero.actions.length > 0 && (
        <div class="btn-row">
          {hero.actions.map((action, index) => (
            <a class:list={["btn", index === 0 ? "btn-light" : "btn-outline"]} href={action.href}>{action.label}</a>
          ))}
        </div>
      )}
      {chips && <EventChips chips={chips} />}
      {(titleBand || photoHero) && <slot name="band" />}
      {titleBand && !photoHero && subnav && (
        <nav aria-label="Event types">
          <ul class="subnav">
            {subnav.map((link) => (
              <li><a href={link.href} aria-current={link.href === meta.path ? "page" : undefined}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>
  <section class="band">
    <div class:list={["container", customBody && "stack"]}>
      {customBody ? <slot /> : <EventList events={events} emptyMessage={emptyMessage} />}
    </div>
  </section>
  <CtaBand
    heading="Hosting an Event?"
    body="Tell us about it and we'll consider it for the events page."
    primary={{ label: "Submit Your Event", href: "/submit-your-event/" }}
  />
</BaseLayout>

<style>
  .page-band .crumbs ol,
  .events-hub-hero .crumbs ol { max-width: 100%; }
  .page-band .crumbs li,
  .events-hub-hero .crumbs li { min-width: 0; max-width: 100%; }
  .events-hub-photo { height: 480px; }
  .events-hub-hero {
    position: relative;
    box-sizing: border-box;
    min-height: 480px;
    display: flex;
    align-items: center;
    padding-block: 1.35rem;
    background: rgba(0, 0, 0, 0.5);
    color: var(--white);
    text-align: center;
  }
  .events-hub-hero h1 { color: var(--white); text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45); }
  .events-hub-hero .lead { color: var(--white); margin-top: 0.75rem; max-width: 40rem; margin-inline: auto; }
  .page-band .crumbs a,
  .page-band .crumbs [aria-current="page"],
  .events-hub-hero .crumbs a,
  .events-hub-hero .crumbs [aria-current="page"] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--white);
    text-align: center;
  }
  .page-band .crumbs [aria-current="page"],
  .events-hub-hero .crumbs [aria-current="page"] { text-decoration: none; }
  .page-band .crumbs li + li::before,
  .events-hub-hero .crumbs li + li::before { color: var(--white); }
  @media (min-width: 720px) {
    .events-hub-photo { height: 400px; }
    .events-hub-hero { min-height: 400px; }
  }
  .page-band .btn-row { margin-top: 1rem; }
  .event-crumb-row { padding-block: 1rem 0; }
  .event-crumb-row .crumbs ol { justify-content: flex-start; }
</style>
