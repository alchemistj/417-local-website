---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import skyline from "../assets/decor/springfield-skyline.png";

/** A post, or a list card with no photo. Lists use the skyline fallback. */
interface CardPost {
  id: string;
  data: {
    title: string;
    heroImage?: ImageMetadata;
    heroPosition?: string;
  };
}

interface Props {
  post: CardPost;
  /** First cards on a page can opt out of lazy loading; below the fold they stay lazy. */
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
const { title, heroImage, heroPosition } = post.data;
---

<!-- Photo with the title over a dark gradient at the bottom (the live homepage card style). -->
<li class={heroImage ? "card" : "card card-noimg"} style={heroPosition ? `--hero-pos: ${heroPosition}` : undefined}>
  {heroImage ? (
    <Image
      class="card-img"
      src={heroImage}
      alt=""
      width={720}
      height={412}
      widths={[480, 720, 960]}
      sizes="(min-width: 860px) 450px, (min-width: 640px) 45vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  ) : (
    <Image class="card-skyline" src={skyline} alt="" width={720} height={227} loading="lazy" decoding="async" />
  )}
  <div class="card-body">
    <h3 class="card-title"><a href={`/${post.id}/`}>{title}</a></h3>
  </div>
</li>
