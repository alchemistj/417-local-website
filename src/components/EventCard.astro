---
import { eventCardModel } from "../lib/eventCard";
import { categoryIcon } from "../lib/eventCardIcons";
import type { EventData } from "../lib/eventSchema";

interface Props {
  event: EventData;
  /** From `runRangeLabel`, such as "Nov 27–29". */
  runRange?: string | null;
  price?: string;
  venueHref?: string;
  venueExternal?: boolean;
}

const { event, runRange = null, price = "", venueHref = "", venueExternal = false } = Astro.props;
const card = eventCardModel(event, { runRange, price });
const icon = categoryIcon(card.palette.id);
const style = `--card-from:${card.palette.from};--card-to:${card.palette.to}`;
---

<div class="event-card" style={style} data-event-card data-palette={card.palette.id}>
  <div class="event-card-date">
    <p class="event-card-month">{card.month}</p>
    <p class="event-card-day">{card.day}</p>
    <p class="event-card-schedule">{card.schedule}</p>
  </div>
  <div class="event-card-body">
    {card.category && <p class="event-card-category">{card.category}</p>}
    <h1 class="event-card-title">{card.title}</h1>
    {card.runLabel && <p class="event-card-run">{card.runLabel}</p>}
    {card.price && <p class="event-card-price">{card.price}</p>}
    {card.venueLine && (
      <p class="event-card-venue">
        {card.venueName && venueHref ? (
          <a href={venueHref} rel={venueExternal ? "noopener" : undefined}>{card.venueName}</a>
        ) : card.venueName}
        {card.venueName && card.cityName ? " · " : ""}
        {card.cityName}
      </p>
    )}
  </div>
  <svg class="event-card-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    {icon.paths.map((d) => <path fill="currentColor" fill-rule={icon.fillRule} d={d} />)}
  </svg>
</div>

<style is:global>
  .event-card-band { padding: 1.25rem 0 0.25rem; }
  .event-card { position: relative; display: flex; flex-direction: column; gap: 0.85rem; overflow: hidden; border-radius: 16px; padding: 1.05rem 1.1rem 1.15rem; color: #fff; background: linear-gradient(135deg, var(--card-from), var(--card-to)); }
  .event-card-date { position: relative; z-index: 1; display: flex; flex-direction: row; align-items: baseline; gap: 0.65rem; }
  .event-card p { margin: 0; color: #fff; }
  .event-card-month { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .event-card-day { font-size: 2.35rem; font-weight: 700; line-height: 0.85; }
  .event-card-schedule { font-size: 0.95rem; }
  .event-card-body { position: relative; z-index: 1; display: flex; flex-direction: column; min-width: 0; }
  .event-card-category { margin-bottom: 0.3rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .event-card h1.event-card-title { margin: 0; color: #fff; font-size: clamp(1.35rem, 2.6vw, 1.85rem); font-weight: 700; line-height: 1.25; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  .event-card-run, .event-card-price { margin-top: 0.45rem; }
  .event-card-venue { margin-top: 0.7rem; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .event-card a { color: #fff; }
  .event-card-icon { position: absolute; z-index: 0; top: 0.35rem; right: 0.4rem; width: 6.5rem; height: 6.5rem; color: #fff; opacity: 0.13; pointer-events: none; }
  .event-card-note { margin: 0.85rem 0 0; }
  @media (min-width: 641px) {
    .event-card { flex-direction: row; align-items: stretch; gap: 1.15rem; min-height: 11.5rem; padding: 1.2rem 1.3rem; }
    .event-card-date { flex-direction: column; align-items: flex-start; justify-content: center; gap: 0.15rem; width: 8.75rem; flex: none; padding: 0.8rem 0.85rem; border-radius: 12px; background: color-mix(in srgb, #000 18%, transparent); }
    .event-card-day { font-size: 3.15rem; }
    .event-card-body { flex: 1; }
    .event-card-venue { margin-top: auto; padding-top: 0.75rem; }
    .event-card-icon { width: 8.5rem; height: 8.5rem; top: 0.55rem; right: 0.6rem; }
  }
</style>
