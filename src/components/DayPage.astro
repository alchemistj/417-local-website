---
import EventFilters from "./EventFilters.astro";
import EventList from "./EventList.astro";
import EventsLayout from "../layouts/EventsLayout.astro";
import type { StaticPageMeta } from "../data/staticPages";
import type { EventChip } from "../lib/eventRoutes";
import type { EventData } from "../lib/eventSchema";
import { recurringPlace, recurringWhen, seriesPath, type RecurringItem } from "../lib/recurring";

interface Props {
  meta: StaticPageMeta;
  h1: string;
  cityName: string;
  hubPath: string;
  events: EventData[];
  weekly: RecurringItem[];
  prev: string | null;
  next: string | null;
  chips: EventChip[];
  city: string;
}
const { meta, h1, cityName, hubPath, events, weekly, prev, next, chips, city } = Astro.props;

/** Short enough to stay on one line at 390px: "Fri, Nov 13". */
function shortDayLabel(ymdDate: string): string {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymdDate);
  if (!match) return ymdDate;
  const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
  return new Intl.DateTimeFormat("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
}
---

<EventsLayout
  meta={meta}
  h1={h1}
  intro={`What is happening in ${cityName} on this day. One-off events are listed by start time.`}
  chips={chips}
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Events", path: "/events/" },
    { name: cityName, path: hubPath },
    { name: h1, path: meta.path },
  ]}
>
  <nav class="day-nav" aria-label="Nearby days">
    {prev ? <a href={`/events/${city}/${prev}/`}>← {shortDayLabel(prev)}</a> : <span></span>}
    {next && <a href={`/events/${city}/${next}/`}>{shortDayLabel(next)} →</a>}
  </nav>
  {events.length > 0 && <EventFilters />}
  {events.length > 0 && <EventList events={events} headings={false} idPrefix="day" />}
  {weekly.length > 0 && (
    <section id="weekly" aria-labelledby="weekly-heading">
      <h2 id="weekly-heading">Weekly happenings this day</h2>
      <ul class="weekly-list">
        {weekly.map((item) => {
          const detail = [recurringWhen(item), recurringPlace(item.venue)].filter(Boolean).join(" · ");
          return (
            <li>
              <a href={seriesPath(item)}>{item.title}</a>
              {detail && <span class="event-place"> {detail}</span>}
            </li>
          );
        })}
      </ul>
    </section>
  )}
</EventsLayout>

<style>
  .day-nav { flex-wrap: nowrap; align-items: center; }
  .day-nav a { white-space: nowrap; }
  .day-nav a:last-child { margin-left: auto; }
</style>
