---
import type { EventChip } from "../lib/eventRoutes";

interface Props {
  chips: EventChip[];
}
const { chips } = Astro.props;
---

<nav aria-label="Event categories">
  <ul class="event-chips">
    {chips.map((chip) => (
      <li><a href={chip.href} aria-current={chip.current ? "page" : undefined}>{chip.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  /* Phones keep the single scrolling row. Wider screens wrap so the last chip is not clipped. */
  @media (min-width: 640px) {
    .event-chips {
      flex-wrap: wrap;
      overflow: visible;
    }
  }
</style>
