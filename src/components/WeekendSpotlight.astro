---
import { eventCardDate } from "../lib/eventCard";
import { eventListTime, topWeekendEvents } from "../lib/calendarView";
import { listRowPlace } from "../lib/eventPage";
import { cityWeekendPath, eventCityName, eventPath } from "../lib/eventPaths";
import { getSiteEvents } from "../lib/loadEvents";
import type { EventData } from "../lib/eventSchema";

const now = new Date();
const picks = topWeekendEvents(await getSiteEvents(), "springfield", now, 3);

/** A street number is not a venue. Show the city instead, matching the event rows. */
function cardVenue(event: EventData): string {
  const cityName = eventCityName(event);
  const place = listRowPlace(event);
  if (!place) return cityName;
  const parts = place.split(" · ");
  const core = parts[0] ?? "";
  if (!/^\d+\s/.test(core)) return place;
  return parts.slice(1).join(" · ") || cityName;
}
---

<section class="weekend-spot" aria-labelledby="weekend-spot-heading">
  <div class="container">
    <h2 id="weekend-spot-heading">This weekend in Springfield</h2>
    {picks.length > 0 ? (
      <ul class="weekend-spot-grid">
        {picks.map((event) => {
          const date = eventCardDate(event);
          const when = eventListTime(event);
          return (
            <li>
              <a class="weekend-spot-card" href={eventPath(event)}>
                <span class="weekend-spot-when">{date.weekday} {date.month} {date.day}</span>
                <span class="weekend-spot-time">{when === "Time TBA" ? "Time\u00A0TBA" : when}</span>
                <span class="weekend-spot-title">{event.title}</span>
                <span class="weekend-spot-venue">{cardVenue(event)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p>Nothing is listed for Springfield this weekend yet.</p>
    )}
    <p class="weekend-spot-more"><a class="btn" href={cityWeekendPath("springfield")}>See all this weekend</a></p>
  </div>
</section>

<style>
  .weekend-spot { padding-block: 1.75rem 0.5rem; }
  .weekend-spot h2 { margin: 0 0 0.85rem; }
  .weekend-spot-grid { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .weekend-spot-card {
    display: flex; flex-direction: column; gap: 0.15rem; min-height: 100%;
    padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 12px;
    color: inherit; text-decoration: none;
  }
  .weekend-spot-card:hover { border-color: var(--blue); }
  .weekend-spot-when, .weekend-spot-time { font-size: 0.85rem; font-weight: 700; color: var(--blue); }
  .weekend-spot-time { color: var(--muted); }
  .weekend-spot-title { font-weight: 700; line-height: 1.35; }
  .weekend-spot-venue { color: var(--muted); font-size: 0.92rem; }
  .weekend-spot-more { margin: 0.9rem 0 0; }
  @media (min-width: 720px) {
    .weekend-spot-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
