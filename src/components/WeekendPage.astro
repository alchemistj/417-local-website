---
import EventChips from "../components/EventChips.astro";
import EventList from "../components/EventList.astro";
import { cityHubPage, cityWeekendCopy, cityWeekendPage } from "../data/staticPages";
import { withCityLabel } from "../data/weekendCities";
import EventsLayout from "../layouts/EventsLayout.astro";
import { uniqueUpcomingEvents, weekendRangeLabel, worthTheDrive } from "../lib/calendarView";
import { eventChips } from "../lib/eventRoutes";
import { WEEKEND_CITY_SLUGS, cityDisplayName, cityWeekendPath, eventCitySlug } from "../lib/eventPaths";
import { emptyWeekendDaysLine, weekendPageDays } from "../lib/events";
import { FRIDAY_TEXT_PATH } from "../lib/fridayText";
import { getRecurring, getSiteEvents } from "../lib/loadEvents";

interface Props {
  city: string;
}

/**
 * slot "picks": hand-picked items from the SEO thread.
 * Pass them as <Fragment slot="picks"> on WeekendPage.
 * An unused slot renders nothing. It sits directly above the day list.
 */
const { city } = Astro.props;
const now = new Date();
const allEvents = await getSiteEvents();
const recurring = await getRecurring();
const events = allEvents.filter((event) => eventCitySlug(event) === city);
const days = weekendPageDays(events, now);
const filled = days.filter((day) => day.events.length > 0);
const emptyLine = emptyWeekendDaysLine(days);
const listed = days.flatMap((day) => day.events);
const drive = worthTheDrive(allEvents, recurring, city, now).map((event) => withCityLabel(event, city));
const shown = new Set(listed.map((event) => event.id));
const also = listed.length < 3
  ? uniqueUpcomingEvents(allEvents, recurring, city, now).filter((event) => !shown.has(event.id)).slice(0, 6)
  : [];
const page = cityWeekendCopy(city);
const meta = cityWeekendPage(city, allEvents, now);
const hub = cityHubPage(city);
const name = cityDisplayName(city);
const others = WEEKEND_CITY_SLUGS.filter((slug) => slug !== city);
const chips = eventChips(city, events, now, "");
const jumpName: Record<string, string> = { Friday: "Fri", Saturday: "Sat", Sunday: "Sun" };
---

<EventsLayout
  meta={meta}
  h1={page.h1}
  intro={page.intro}
  skyline
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Events", path: "/events/" },
    { name: hub.label, path: hub.path },
    { name: "This weekend", path: meta.path },
  ]}
>
  <h2 class="weekend-range">{weekendRangeLabel(now)}</h2>
  {days.length > 0 && (
    <nav class="weekend-jump" aria-label="Friday, Saturday and Sunday">
      {days.map((day) => {
        const name = day.heading.split(",")[0] ?? day.heading;
        const label = jumpName[name] ?? name.slice(0, 3);
        return day.events.length > 0 ? (
          <a href={`#day-${day.date}`}>{label}</a>
        ) : (
          <span>{label}</span>
        );
      })}
    </nav>
  )}
  <slot name="picks" />
  {filled.map((day) => (
    <section aria-labelledby={`day-${day.date}`}>
      <h3 id={`day-${day.date}`} class="event-day-head">{day.heading}</h3>
      <EventList
        events={day.events}
        idPrefix={day.date}
        headings={false}
        allEvents={allEvents}
      />
    </section>
  ))}
  {emptyLine && <p class="weekend-empty">{emptyLine}</p>}
  <EventChips chips={chips} />
  <section aria-labelledby="worth-the-drive">
    <h2 id="worth-the-drive">Worth the drive this weekend</h2>
    <EventList
      events={drive}
      idPrefix="drive"
      headings={false}
      allEvents={allEvents}
      emptyMessage="No nearby one-off events are listed for this weekend."
    />
  </section>
  {also.length > 0 && (
    <section aria-labelledby="next-four-weeks">
      <h2 id="next-four-weeks">The next 4 weeks</h2>
      <EventList events={also} idPrefix="soon" allEvents={allEvents} />
    </section>
  )}
  <div class="btn-row">
    {city === "springfield" && <a class="btn" href={FRIDAY_TEXT_PATH}>This Friday in Springfield</a>}
    <a class="btn" href={hub.path}>Full {name} events calendar</a>
    <a class="btn" href="/events/">Southwest Missouri events</a>
  </div>
  <nav aria-label="This weekend in other cities">
    <p>This weekend in</p>
    <ul class="subnav">
      {others.map((slug) => (
        <li><a href={cityWeekendPath(slug)}>{cityDisplayName(slug)}</a></li>
      ))}
    </ul>
  </nav>
</EventsLayout>

<style>
  .weekend-range { margin: 0 0 0.25rem; color: var(--muted); font-size: 1rem; font-weight: 700; }
  .weekend-jump {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.35rem 0 0.85rem;
  }
  .weekend-jump a,
  .weekend-jump span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 2px solid var(--line);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: var(--muted);
  }
  .weekend-jump a { border-color: var(--blue); color: var(--blue); }
  .weekend-jump a:hover { background: var(--blue); color: var(--white); }
  .weekend-empty { margin: 0.75rem 0 0; }
  /* The guide skyline sits in the bottom padding. Extra room keeps the lead off the buildings. */
  :global(.page-band.skyline-band) { padding-bottom: 14rem; }
</style>
