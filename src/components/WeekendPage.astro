---
import EventList from "../components/EventList.astro";
import { cityHubPage, cityWeekendCopy, cityWeekendPage } from "../data/staticPages";
import { withCityLabel } from "../data/weekendCities";
import EventsLayout from "../layouts/EventsLayout.astro";
import { uniqueUpcomingEvents, worthTheDrive } from "../lib/calendarView";
import { eventChips } from "../lib/eventRoutes";
import { WEEKEND_CITY_SLUGS, cityDisplayName, cityWeekendPath, eventCitySlug } from "../lib/eventPaths";
import { eventChicagoDate, formatDayHeading, isUpcoming, sortByStart, weekendDateStrings } from "../lib/events";
import { getRecurring, getSiteEvents } from "../lib/loadEvents";

interface Props {
  city: string;
}
const { city } = Astro.props;
const now = new Date();
const allEvents = await getSiteEvents();
const recurring = await getRecurring();
const events = allEvents.filter((event) => eventCitySlug(event) === city);
const [friday, saturday, sunday] = weekendDateStrings(now);
const days = [friday, saturday, sunday].map((date) => ({
  date,
  heading: formatDayHeading(date),
  events: sortByStart(events.filter((event) => isUpcoming(event, now) && eventChicagoDate(event) === date)),
}));
const listed = days.flatMap((day) => day.events);
const drive = worthTheDrive(allEvents, recurring, city, now).map((event) => withCityLabel(event, city));
const shown = new Set(listed.map((event) => event.id));
const also = listed.length < 3
  ? uniqueUpcomingEvents(allEvents, recurring, city, now).filter((event) => !shown.has(event.id)).slice(0, 6)
  : [];
const page = cityWeekendCopy(city);
const meta = cityWeekendPage(city, allEvents, now);
const hub = cityHubPage(city);
const name = cityDisplayName(city);
const others = WEEKEND_CITY_SLUGS.filter((slug) => slug !== city);
const rangeHeading = `${formatDayHeading(friday)} to ${formatDayHeading(sunday)}`;
---

<EventsLayout
  meta={meta}
  h1={page.h1}
  intro={page.intro}
  chips={eventChips(city, events, now, "")}
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Events", path: "/events/" },
    { name: hub.label, path: hub.path },
    { name: page.h1, path: meta.path },
  ]}
>
  <h2>{rangeHeading}</h2>
  {days.map((day) => (
    <section aria-labelledby={`day-${day.date}`}>
      <h2 id={`day-${day.date}`}>{day.heading}</h2>
      <EventList
        events={day.events}
        idPrefix={day.date}
        headings={false}
        allEvents={allEvents}
        emptyMessage={`Nothing listed for ${day.heading}.`}
      />
    </section>
  ))}
  <section aria-labelledby="worth-the-drive">
    <h2 id="worth-the-drive">Worth the drive this weekend</h2>
    <EventList
      events={drive}
      idPrefix="drive"
      headings={false}
      allEvents={allEvents}
      emptyMessage="No nearby one-off events are listed for this weekend."
    />
  </section>
  {also.length > 0 && (
    <section aria-labelledby="next-four-weeks">
      <h2 id="next-four-weeks">The next 4 weeks</h2>
      <EventList events={also} idPrefix="soon" allEvents={allEvents} />
    </section>
  )}
  <p><a class="more-link" href={hub.path}>Full {name} events calendar</a></p>
  <p><a class="more-link" href="/events/">Southwest Missouri events</a></p>
  <nav aria-label="This weekend in other cities">
    <p>This weekend in</p>
    <ul class="subnav">
      {others.map((slug) => (
        <li><a href={cityWeekendPath(slug)}>{cityDisplayName(slug)}</a></li>
      ))}
    </ul>
  </nav>
</EventsLayout>
