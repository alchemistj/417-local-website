---
interface Props {
  heading: string;
  body: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { heading, body, primary, secondary } = Astro.props;
---

<section class="band band-accent" aria-labelledby="cta-heading">
  <div class="container stack">
    <h2 id="cta-heading">{heading}</h2>
    <p class="lead">{body}</p>
    <div class="btn-row">
      <a class="btn btn-light" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn-outline" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>
