---
import type { EventData } from "../lib/eventSchema";
import { formatEventDate, formatPrice, placeName } from "../lib/events";
import { eventPath } from "../lib/eventPaths";

interface Props {
  events: EventData[];
  /** When set, replaces the business-events empty sentence. */
  emptyMessage?: string;
}
const { events, emptyMessage } = Astro.props;
---

{events.length === 0 ? (
  <div class="empty-state">
    {emptyMessage ? (
      <p>{emptyMessage}</p>
    ) : (
      <p>
        New Springfield business events are added every week. Check back soon or
        <a href="/submit-your-event/">submit yours</a>.
      </p>
    )}
  </div>
) : (
  <ul class="event-list">
    {events.map((e) => {
      const place = [placeName(e.venue), e.city].filter(Boolean).join(", ");
      const price = formatPrice(e);
      return (
        <li>
          <h3><a href={eventPath(e)}>{e.title}</a></h3>
          <p class="event-meta">{formatEventDate(e)}{place && ` · ${place}`}{price && ` · ${price}`}</p>
          {e.description && <p>{e.description}</p>}
        </li>
      );
    })}
  </ul>
)}
