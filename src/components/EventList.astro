---
import type { EventData } from "../lib/eventSchema";
import { eventRun, groupEventsByDay, eventListTime, isKidsEvent, runRangeLabel, showsFreeTag } from "../lib/calendarView";
import { cardPaletteForCategory, eventCardDate } from "../lib/eventCard";
import { categoryLabel } from "../lib/eventPage";
import { listRowPlace } from "../lib/eventPage";
import { primaryCategory } from "../lib/events";
import { eventPath } from "../lib/eventPaths";
import { getSiteEvents } from "../lib/loadEvents";

interface Props {
  events: EventData[];
  /** When set, replaces the business-events empty sentence. */
  emptyMessage?: string;
  /** Keeps day-header ids unique when more than one list is on the page. */
  idPrefix?: string;
  /** Day pages already name the date in the H1. */
  headings?: boolean;
  /** Every site event, used to find each row's run. Defaults to the loaded export. */
  allEvents?: EventData[];
}
const { events, emptyMessage, idPrefix = "events", headings = true, allEvents } = Astro.props;
const now = new Date();
const pool = allEvents ?? (await getSiteEvents());
const groups = groupEventsByDay(events);
---

{events.length === 0 ? (
  <div class="empty-state">
    {emptyMessage ? (
      <p>{emptyMessage}</p>
    ) : (
      <p>
        New Springfield business events are added every week. Check back soon or
        <a href="/submit-your-event/">submit yours</a>.
      </p>
    )}
  </div>
) : (
  groups.map((group) => (
    <section class="event-day" data-event-day aria-labelledby={headings ? `day-${idPrefix}-${group.date}` : undefined}>
      {headings && <h2 id={`day-${idPrefix}-${group.date}`} class="event-day-head">{group.heading}</h2>}
      <ul class="event-rows">
        {group.events.map((event) => {
          const place = listRowPlace(event);
          const when = eventListTime(event);
          const run = eventRun(event, pool, now);
          const href = run ? eventPath(run.canonical) : eventPath(event);
          const range = runRangeLabel(run);
          const tags = event.categories.slice(0, 2).map((slug) => categoryLabel(slug));
          const date = eventCardDate(event);
          const tile = cardPaletteForCategory(primaryCategory(event)).solid;
          return (
            <li
              class="event-row"
              data-event-row
              data-free={showsFreeTag(event) ? "true" : undefined}
              data-kids={isKidsEvent(event) ? "true" : undefined}
            >
              <a class="event-row-link" href={href}>
                <span class="date-tile" style={`background:${tile}`}>
                  <span class="date-tile-day">{date.day}</span>
                  <span class="date-tile-month">{date.month}</span>
                </span>
                <span class="event-row-text">
                  <span class="event-line">
                    <span class="event-title">{event.title}</span>
                    {place && <span class="event-place"> · {place}</span>}
                    {range && <span class="event-place"> · Runs {range}</span>}
                  </span>
                  <span class="event-tags">
                    {when !== "Time TBA" && <span class="event-when">{when}</span>}
                    {tags.map((tag) => <span class="event-tag">{tag}</span>)}
                    {showsFreeTag(event) && <span class="event-tag">Free</span>}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))
)}
